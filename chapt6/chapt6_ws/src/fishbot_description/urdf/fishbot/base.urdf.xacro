<?xml version="1.0"?>   <!-- xml格式声明-->
<!-- 注意xacro不能直接用，必须要先将xacro转换成urdf才能使用 可以使用命令xacro /home/adams/chapt6/chapt6_ws/src/fishbot_description/urdf/first_robot.xacro 来生成对应urdf文件-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">  <!--xmlns:xacro="http://www.ros.org/wiki/xacro" 是告诉大家这个urdf使用了宏语言了-->
    <!-- 引入描述质量和惯性的宏定义文件 -->
    <xacro:include filename="$(find fishbot_description)/urdf/fishbot/common_inertia.xacro"/>   <!--$(find fishbot_description)表示找到share目录下的fishbot_description(功能包的名字)目录-->

    <xacro:macro name="base_xacro" params="length radius">
        <!-- 定义base_link的虚拟部件，base_link相对于地面的投影，xy相同，z是base_link几何中心到地面的距离 -->
        <link name="base_footprint"/>

        <!--机器人身体部分-->
        <link name="base_link">  <!--子部件-->
            <!--  部件的外观描述 -->
            <visual>
                <!-- 沿着自己几何中心的偏移和旋转量 xyz表示偏移 rpy表示旋转(欧拉角表示)-->
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <!-- 圆柱体 radius半径，length高度 单位是m-->
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <!-- 材质颜色描述 -->
                <material name="white">
                    <!-- 颜色 红绿蓝和透明度，取值范围0.0-1.0   0.5表示半透明 -->
                    <color rgba="1.0 1.0 1.0 0.5"/>
                </material>
            </visual>
            <!-- 碰撞属性 -->
            <collision>
                <!-- 沿着自己几何中心的偏移和旋转量 xyz表示偏移 rpy表示旋转(欧拉角表示)-->
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <!-- 圆柱体 radius半径，length高度 单位是m-->
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <!-- 材质颜色描述 -->
                <material name="white">
                    <!-- 颜色 红绿蓝和透明度，取值范围0.0-1.0   0.5表示半透明 -->
                    <color rgba="1.0 1.0 1.0 0.5"/>
                </material>
            </collision>

            <!-- 设置base_link的质量和惯性 -->
            <xacro:cylinder_inertia m="1.0" r="${radius}" h="${length}"/>
        </link>

         <joint name="joint_name" type="fixed">
            <!--${length/2 + 0.032 - 0.001} 表示虚拟部件的位置，0.032表示左右轮子的半径  -->
            <origin xyz="0.0 0.0 ${length/2.0+0.032-0.001}" rpy="0.0 0.0 0.0"/>
            <parent link="base_footprint"/>
            <child link="base_link"/>
        </joint>
    </xacro:macro>
   
</robot>


