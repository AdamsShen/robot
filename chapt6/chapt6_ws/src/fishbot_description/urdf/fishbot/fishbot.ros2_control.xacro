<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="fishbot_ros2_control">
        <ros2_control name="FishBotGazeboSystem" type="system">
            <!--hardware用于设置硬件以及硬件相关的配置  -->
            <hardware>
                <!-- plugin用于设置驱动库的名字 -->
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>
            <joint name="left_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">-1</param>
                    <param name="max">1</param>
                </command_interface>
                <command_interface name="effort">
                    <param name="min">-0.1</param>
                    <param name="max">0.1</param>
                </command_interface>
                <!-- 轮子位置 -->
                <state_interface name="position" />
                <!-- 轮子转速 -->
                <state_interface name="velocity" />
                <!-- 轮子力矩 -->
                <state_interface name="effort" />
            </joint>
            <joint name="right_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">-1</param>
                    <param name="max">1</param>
                </command_interface>
                <command_interface name="effort">
                    <param name="min">-0.1</param>
                    <param name="max">0.1</param>
                </command_interface>
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
        </ros2_control>

        <gazebo>
            <!-- libgazebo_ros2_control.so 插件会解析<ros2_control></ros2_control>标签，然后再使用 -->
            <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
                <parameters>$(find fishbot_description)/config/fishbot_ros2_controller.yaml</parameters>
                <ros>
                    <!-- 话题的重映射，相当于话题的重命名 -->
                    <remapping>/fishbot_diff_drive_controller/odom:=/odom</remapping>  <!--重命令为/odom-->
                    <remapping>/fishbot_diff_drive_controller/cmd_vel_unstamped:=/cmd_vel</remapping> <!--重命名为/cmd_vel_unstamped-->
                </ros>
            </plugin>
        </gazebo>
    </xacro:macro>
</robot>
